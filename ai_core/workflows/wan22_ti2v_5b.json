{
 "name": "wan22_ti2v_5b",
 "description": "Wan 2.2 TI2V 5B image-to-video (24 fps). Requires ComfyUI-GGUF. 'image' is a local file path uploaded to ComfyUI. length must be 4n+1 frames (121 = ~5 s).",
 "inputs": {
  "image": {"node": "10", "field": "image", "type": "file", "required": true},
  "prompt": {"node": "4", "field": "text", "type": "string", "required": true},
  "negative": {"node": "5", "field": "text", "type": "string", "default": "blurry, distorted, low quality, static, watermark, text, extra limbs, deformed face"},
  "width": {"node": "11", "field": "width", "type": "int", "default": 704},
  "height": {"node": "11", "field": "height", "type": "int", "default": 1280},
  "length": {"node": "11", "field": "length", "type": "int", "default": 121},
  "seed": {"node": "6", "field": "seed", "type": "int", "default": 0}
 },
 "outputs": ["9"],
 "prompt": {
  "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "Wan2.2-TI2V-5B-Q8_0.gguf"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative}}", "clip": ["2", 0]}},
  "6": {"class_type": "KSampler", "inputs": {"model": ["12", 0], "seed": "{{seed}}", "steps": 20, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["11", 0], "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["6", 0], "vae": ["3", 0]}},
  "9": {"class_type": "SaveVideo", "inputs": {"video": ["13", 0], "filename_prefix": "mg_wan22", "format": "mp4", "codec": "h264"}},
  "10": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}},
  "11": {"class_type": "Wan22ImageToVideoLatent", "inputs": {"vae": ["3", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{length}}", "batch_size": 1, "start_image": ["10", 0]}},
  "12": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 8.0}},
  "13": {"class_type": "CreateVideo", "inputs": {"images": ["8", 0], "fps": 24.0}}
 }
}
